{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src/main/ts",
    "outDir": "target/esm",
    "declaration": true,
    "declarationDir": "target/dts",
    "skipLibCheck": true
  },
  "include": ["src/main/ts"]
}
