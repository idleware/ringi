{
  "name": "@idleware/ringi",
  "version": "0.12.5",
  "description": "Distributed agent coordinator",
  "os": [
    "darwin",
    "linux"
  ],
  "keywords": [
    "agents",
    "multi-agent",
    "coordination",
    "git",
    "claude",
    "codex",
    "cursor",
    "skill",
    "agent-skills",
    "ringi"
  ],
  "homepage": "https://github.com/idleware/ringi#readme",
  "repository": "github:idleware/ringi",
  "author": "Anton Golub <antongolub@antongolub.com>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ringi": "target/esm/cli.js"
  },
  "exports": {
    ".": {
      "types": "./target/dts/index.d.ts",
      "import": "./target/esm/index.js"
    }
  },
  "types": "target/dts/index.d.ts",
  "files": [
    "target/esm",
    "!target/esm/**/*.map",
    "target/dts",
    "src/main/resources"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('target/esm/cli.js', 0o755)\"",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test --test-reporter=spec src/test/ts/*.test.ts",
    "test:conformance": "node --test --test-reporter=spec src/test/ts/ringi.test.ts src/test/ts/model.test.ts src/test/ts/flow.test.ts",
    "commands": "node target/esm/cli.js help --md > COMMANDS.md",
    "release": "npx --yes zx-semrel@1.25.1",
    "test:coverage": "npm run build && tsc -p tsconfig.test.json && c8 --reporter=lcov --reporter=text-summary --report-dir=target/coverage --exclude-after-remap --include='src/main/ts/**' node --test src/test/ts/*.test.ts",
    "test:smoke": "node --test --test-reporter=spec src/test/ts/flow.test.ts",
    "test:it": "npm run build && tsc -p tsconfig.test.json && node --test --test-concurrency=1 --test-reporter=spec src/test/it/*.it.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "c8": "12.0.0",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
